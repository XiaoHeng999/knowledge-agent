{
  "name": "agentclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-based intelligent knowledge base \u2014 comprehension over retrieval",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:next\" \"pnpm run dev:electron\"",
    "dev:next": "next dev --turbopack",
    "dev:electron": "esbuild electron/main.ts electron/preload.ts server/worker/worker-process.ts --bundle --platform=node --outdir=dist --external:electron --external:better-sqlite3 --external:electron-updater --external:jsdom --define:import.meta.url=__import_meta_url__ --banner:js=\"var __import_meta_url__=require('url').pathToFileURL(__filename).href;\" && electron . --no-sandbox",
    "build": "next build && esbuild electron/main.ts electron/preload.ts server/worker/worker-process.ts --bundle --platform=node --outdir=dist --external:electron --external:better-sqlite3 --external:electron-updater --external:jsdom --define:import.meta.url=__import_meta_url__ --banner:js=\"var __import_meta_url__=require('url').pathToFileURL(__filename).href;\"",
    "build:electron": "esbuild electron/main.ts electron/preload.ts server/worker/worker-process.ts --bundle --platform=node --outdir=dist --external:electron --external:better-sqlite3 --external:electron-updater --external:jsdom --define:import.meta.url=__import_meta_url__ --banner:js=\"var __import_meta_url__=require('url').pathToFileURL(__filename).href;\"",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:win": "pnpm run build && electron-builder --win",
    "build:linux": "pnpm run build && electron-builder --linux",
    "build:all": "pnpm run build && electron-builder --mac --win --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.7.0",
    "d3": "^7.9.0",
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^5.8.0",
    "gray-matter": "^4.0.3",
    "next": "^15.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turndown": "^7.2.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}